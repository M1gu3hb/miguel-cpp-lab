# Base de datos (Supabase). La publishable key es pública por diseño: RLS y los
# permisos de la tabla son lo que protege los datos. Aun así se lee sólo en el
# servidor, nunca se envía al navegador.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave del profesor. Se usa para /profesor y para la API de revisión.
# Mínimo 12 caracteres. Nunca se escribe en el código ni en el repositorio.
PROFESSOR_KEY=

# Compilador (opcional). Por defecto GCC 13.2 en Compiler Explorer con -std=c++17.
# CPP_COMPILER_ID=g132
# CPP_COMPILER_LABEL=g++ 13.2 · -std=c++17
# CPP_COMPILER_ARGS=-std=c++17 -O1 -Wall
