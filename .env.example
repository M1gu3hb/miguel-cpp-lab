# Conexión con Supabase. La publishable key no es un secreto (viaja con el rol
# anon, cuyos permisos están acotados por RLS y grants), pero no se guarda en el
# repositorio: se define aquí en local y en las variables de entorno de Vercel.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Compilador (opcional). Por defecto GCC 13.2 en Compiler Explorer con -std=c++17.
# CPP_COMPILER_ID=g132
# CPP_COMPILER_LABEL=g++ 13.2
# CPP_COMPILER_ARGS=-std=c++17 -O1 -Wall
